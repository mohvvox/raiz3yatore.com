# RAIZEY STORE — متغيرات البيئة
# انسخ هذا الملف إلى .env.local محلياً، وأضف نفس القيم في Vercel > Project Settings > Environment Variables.
# ممنوع رفع ملف .env.local إلى GitHub (مستثنى في .gitignore).

# ── Supabase (إلزامي) ───────────────────────────────────────────────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح service role: يتجاوز RLS — يُستخدم في السيرفر فقط (عمليات المحفظة والأدمن)
SUPABASE_SERVICE_ROLE_KEY=

# ── الموقع (إلزامي) ─────────────────────────────────────────────────
# رابط الموقع الأساسي بدون / في النهاية
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── اختياري ─────────────────────────────────────────────────────────
# رابط إعادة توجيه المصادقة في بيئة التطوير (يوفره v0 تلقائياً)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
# Sentry لرصد الأخطاء (يُضاف في مرحلة المراجعة الأمنية)
NEXT_PUBLIC_SENTRY_DSN=
# رقم واتساب الدعم بالصيغة الدولية بدون +
NEXT_PUBLIC_WHATSAPP_NUMBER=
